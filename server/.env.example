# Copy to .env for local development.
PORT=3002
DATABASE_URL=postgres://milson:milson123@localhost:5432/milson_pipeline
DATABASE_SSL=false
JWT_SECRET=change-me
JWT_EXPIRES_IN=12h
STORAGE_DRIVER=local
STORAGE_DIR=./uploads
# Set STORAGE_DRIVER=s3 and fill these in to store uploads in a private S3 bucket.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=
MAX_UPLOAD_BYTES=104857600
SEED_ADMIN_EMAIL=admin@milsonfoundry.com
SEED_ADMIN_PASSWORD=Admin123!
